# UNOS AUTOMATIONS — Environment Variables
# Copy this file to .env.local:
#   cp .env.example .env.local
# Then fill in your real credentials below.
# NEVER commit .env.local to GitHub or public repositories.

# ─── Contact Form Email Setup (SMTP) ──────────────────────────────────────────
# If using Gmail:
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
#    (Select App: "Mail", Device: "Other" -> Name it "UNOS Website")
# 3. Paste the generated 16-character code into SMTP_PASS below (no spaces).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sending-account@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# ─── Receiving Email Address ──────────────────────────────────────────────────
# The email address that will receive project enquiries submitted by visitors:
CONTACT_EMAIL_TO=your-receiving-inbox@gmail.com

# ─── Optional: WhatsApp Notification Webhook ──────────────────────────────────
# If you have an automation webhook (n8n, Make, or WhatsApp Business API provider),
# set its URL below to receive instant WhatsApp alerts when a lead submits the form.
# If omitted or left empty, enquiries will still be delivered via email.
WHATSAPP_WEBHOOK_URL=

# ─── WhatsApp Direct Chat Number ──────────────────────────────────────────────
# The direct WhatsApp chat button is configured centrally in:
#   src/lib/config.ts -> whatsappNumber: "919182078320"
# (India +91, mobile 9182078320). No changes needed here.
